# Copia questo file in .streamlit/secrets.toml (non committare il file reale)

# URL del tuo backend FastAPI (es. Railway, Render, VPS)
BACKEND_URL     = "https://il-tuo-backend.railway.app"

# API key che backend.py richiede via header x-api-key
BACKEND_API_KEY = "la-tua-api-key-segreta"

# Slug del progetto Quire (visibile nell'URL: quire.io/w/<QUIRE_PROJECT_ID>/...)
QUIRE_PROJECT_ID = "il-tuo-project-slug"

# Tag da mostrare al VA — cambia qui senza toccare il codice
DELEGABLE_TAG   = "delegabile"

# Filtra per stato: active | completed | all
TASK_STATUS     = "active"

# Password da dare al VA. Lascia vuoto ("") per disabilitare il gate.
VA_PASSWORD     = "scegli-password-sicura"
